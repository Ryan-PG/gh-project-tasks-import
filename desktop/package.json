{
  "name": "github-importer-desktop",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Desktop app that imports a task backlog into GitHub Issues and Projects",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icon": "tauri icon src-tauri/icons/source.png",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "fixtures": "python scripts/make_fixtures.py",
    "parity": "python scripts/parity_oracle.py",
    "parity:build": "python scripts/parity_oracle.py --build",
    "check": "npm run typecheck && npm run test:rust && npm run parity:build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
