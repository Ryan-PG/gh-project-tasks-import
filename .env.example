# GitHub Project Tasks Importer — optional configuration.
# Copy to .env and edit:
#
#     cp .env.example .env
#
# Environment variables already set in your shell take precedence over this
# file, so CI can override without editing anything here.

# strict = abort on the first parent / blocked-by failure (original behaviour)
# ignore = tolerate links that are already set and continue through every task
RELATIONSHIP_ERRORS=strict

# true = skip the parent / blocked-by pass entirely.
#        Issues are still created; no links are applied.
SKIP_RELATIONSHIPS=false
